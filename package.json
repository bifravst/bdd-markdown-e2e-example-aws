{
  "name": "@bifravst/e2e-bdd-test-runner-example",
  "version": "0.0.0-development",
  "description": "Example use of @bifravst/bdd-markdown",
  "type": "module",
  "scripts": {
    "test": "$(set -o pipefail && npx tsx features/run-features.ts | npx tsx features/console-reporter.ts)",
    "test:unit": "npx tsx --test ./features/*.spec.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/bdd-markdown-e2e-example-aws.git"
  },
  "keywords": [
    "bdd",
    "aws",
    "cloudnative",
    "e2e",
    "bdd",
    "testing"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/bifravst/bdd-markdown-e2e-example-aws/issues"
  },
  "homepage": "https://github.com/bifravst/bdd-markdown-e2e-example-aws#readme",
  "devDependencies": {
    "@aws-lambda-powertools/tracer": "2.30.1",
    "@aws-sdk/client-cloudformation": "3.965.0",
    "@aws-sdk/client-sqs": "3.965.0",
    "@aws-sdk/client-xray": "3.965.0",
    "@bifravst/bdd-markdown": "8.2.80",
    "@bifravst/cloudformation-helpers": "9.1.1",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "19.8.1",
    "@sinclair/typebox": "0.34.47",
    "@swc/core": "1.15.8",
    "@types/aws-lambda": "8.10.159",
    "@types/glob": "9.0.0",
    "@types/node": "22.19.3",
    "@types/yazl": "3.3.0",
    "aws-cdk-lib": "2.233.0",
    "cdk": "2.1100.3",
    "commitlint": "19.8.1",
    "constructs": "10.4.4",
    "dependency-tree": "11.2.0",
    "glob": "11.1.0",
    "husky": "9.1.7",
    "node-fetch": "3.3.2",
    "tsx": "4.21.0",
    "yazl": "3.3.1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,js}": [
      "prettier --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "prettier": "@bifravst/prettier-config"
}
